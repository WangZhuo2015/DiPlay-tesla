<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_browser_connection">Tesla 브라우저 (실험 기능)</string>
    <string name="settings_browser_connection_hint">같은 네트워크에서 Tesla 브라우저로 CarPlay를 엽니다. 오디오는 Android 호스트 또는 iPhone의 Bluetooth 연결을 사용합니다. 선택 사항인 프록시는 별도로 실행됩니다.</string>
    <string name="settings_browser_display">Tesla 해상도 (실험 기능)</string>
    <string name="settings_browser_display_hint">오른쪽 창과 전체 창의 픽셀 크기를 따로 저장합니다. 변경 사항은 다음 CarPlay 연결부터 적용됩니다. 준비되면 다시 연결하세요.</string>
    <string name="settings_browser_right">오른쪽 창</string>
    <string name="settings_browser_full">전체 창</string>
    <string name="settings_browser_right_width">오른쪽 창 너비(픽셀)</string>
    <string name="settings_browser_right_height">오른쪽 창 높이(픽셀)</string>
    <string name="settings_browser_full_width">전체 창 너비(픽셀)</string>
    <string name="settings_browser_full_height">전체 창 높이(픽셀)</string>
    <string name="settings_browser_fps">프레임 속도(5–60 fps)</string>
    <string name="settings_browser_quality">JPEG 화질(40–95)</string>
    <string name="settings_browser_invalid">짝수 픽셀 크기를 사용하세요. 너비 320–2560, 높이 240–1440, 프레임 속도 5–60, 화질 40–95.</string>
    <string name="settings_browser_pairing_hint">Tesla를 휴대폰과 같은 네트워크에 연결하고 아래 주소를 여세요. 6자리 코드를 입력하거나 링크를 복사하세요. 코드는 5분 동안 유효합니다. 브라우저가 연결을 기억합니다. 코드가 만료되거나 5번 실패하면 이 페이지를 다시 열어 새 코드를 받으세요.</string>
    <string name="settings_browser_pairing_code">6자리 페어링 코드</string>
    <string name="settings_browser_copy_link">브라우저 링크 복사</string>
    <string name="settings_browser_waiting">네트워크 또는 CarPlay 연결 대기 중</string>
</resources>
